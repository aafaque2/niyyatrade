generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  EXECUTED
  FAILED
  CANCELLED
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique @db.VarChar(255)
  name              String?  @db.VarChar(255)
  passwordHash      String?
  authProviderId    String?  @db.VarChar(255)
  activeFrameworkId String?  @db.Uuid
  currency          String   @default("USD") @db.VarChar(3)
  tokenVersion      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  activeFramework     Framework?           @relation(fields: [activeFrameworkId], references: [id], onDelete: SetNull)
  portfolio           Portfolio?
  frameworkOverrides  FrameworkOverride[]
  watchlists          Watchlist[]
  complianceAudits    ComplianceAudit[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Portfolio {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  availableCashCents BigInt   @default(10000000)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions    Position[]
  orders       Order[]
  transactions Transaction[]

  @@index([userId])
}

model Position {
  id                String  @id @default(uuid()) @db.Uuid
  portfolioId       String  @db.Uuid
  assetTicker       String  @db.VarChar(20)
  quantity          Decimal @db.Decimal(15, 6)
  averagePriceCents BigInt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetTicker], references: [ticker], onDelete: Restrict)

  @@unique([portfolioId, assetTicker])
  @@index([portfolioId, assetTicker])
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  portfolioId        String      @db.Uuid
  assetTicker        String      @db.VarChar(20)
  side               OrderSide
  quantity           Decimal     @db.Decimal(15, 6)
  targetPriceCents   BigInt?
  executedPriceCents BigInt?
  status             OrderStatus @default(PENDING)
  executedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  portfolio   Portfolio    @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset       Asset        @relation(fields: [assetTicker], references: [ticker], onDelete: Restrict)
  transaction Transaction?

  @@index([portfolioId, status])
  @@index([portfolioId, createdAt])
  @@index([status])
  @@index([assetTicker])
  @@index([status, expiresAt])
}

model Transaction {
  id                 String          @id @default(uuid()) @db.Uuid
  portfolioId        String          @db.Uuid
  orderId            String          @unique @db.Uuid
  transactionType    TransactionType
  assetTicker        String          @db.VarChar(20)
  quantity           Decimal         @db.Decimal(15, 6)
  pricePerShareCents BigInt
  totalAmountCents   BigInt
  executedAt         DateTime        @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetTicker], references: [ticker], onDelete: Restrict)

  @@index([portfolioId, executedAt])
  @@index([assetTicker])
}

model Asset {
  ticker    String   @id @db.VarChar(20)
  name      String   @db.VarChar(255)
  sector    String   @db.VarChar(100)
  industry  String?  @db.VarChar(100)
  exchange  String   @default("UNKNOWN") @db.VarChar(20)
  currency  String   @default("USD") @db.VarChar(10)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions        Position[]
  orders           Order[]
  transactions     Transaction[]
  watchlistItems   WatchlistItem[]
  complianceAudits ComplianceAudit[]

  @@index([sector])
  @@index([exchange])
  @@index([sector, exchange])
}

model Framework {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(100)
  defaultRules Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  overrides        FrameworkOverride[]
  complianceAudits ComplianceAudit[]
  activeUsers      User[]
}

model FrameworkOverride {
  id               String @id @default(uuid()) @db.Uuid
  userId           String @db.Uuid
  frameworkId      String @db.Uuid
  customThresholds Json

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  framework Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@unique([userId, frameworkId])
  @@index([frameworkId])
}

model Watchlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String   @id @default(uuid()) @db.Uuid
  watchlistId String   @db.Uuid
  assetTicker String   @db.VarChar(20)
  addedAt     DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetTicker], references: [ticker], onDelete: Restrict)

  @@unique([watchlistId, assetTicker])
  @@index([assetTicker])
}

model ComplianceAudit {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  assetTicker String   @db.VarChar(20)
  frameworkId String   @db.Uuid
  verdict     String   @db.VarChar(20)
  rules       Json
  evaluatedAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  framework Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetTicker], references: [ticker], onDelete: Restrict)

  @@index([userId, evaluatedAt])
  @@index([userId, assetTicker])
  @@index([frameworkId])
}

model FxDailyRate {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  base      String   @default("USD") @db.VarChar(3)
  rates     Json
  source    String   @db.VarChar(50)
  fetchedAt DateTime @default(now())

  @@index([date])
}
